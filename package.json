{
  "name": "voice-werewolf-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Voice-driven Werewolf game powered by AssemblyAI and DeepSeek",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=server"
  },
  "keywords": [
    "werewolf",
    "assemblyai",
    "voice-agent",
    "hackathon",
    "deepseek"
  ],
