# 服务端 HTTP 与 WebSocket 监听端口
PORT=3001

# AssemblyAI 实时语音转写 API Key, 若为空则自动启用 Mock 转写模式
ASSEMBLYAI_API_KEY=

# DeepSeek 开放平台 API Key, 若为空则自动启用 Mock 逻辑大脑模式
DEEPSEEK_API_KEY=

# DeepSeek API 基础调用地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 对话补全模型代号
DEEPSEEK_MODEL=deepseek-chat

# 是否强制开启 Mock 语音转写模式 (true/false)
MOCK_VOICE=false

# 是否强制开启 Mock 大语言模型模式 (true/false)
MOCK_LLM=false